# Copy to `.env` (git-ignored) and change every "change_me" value. These are for
# a LOCAL, throw-away development stack only. Never commit a real `.env`.
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env

# ---- PostgreSQL warehouse (pipeline target) ----
POSTGRES_DB=airquality
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change_me_warehouse
# Used by LOCAL (non-Docker) runs to reach the dockerised warehouse on the host.
# Containers ignore these two and use warehouse:5432 (set in docker-compose.yml).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
WAREHOUSE_HOST_PORT=5433

# ---- Airflow ----
AIRFLOW_UID=50000
AIRFLOW_DB_PASSWORD=change_me_airflow_db
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_admin
# Generate your own:  python -c "import secrets; print(secrets.token_hex(16))"
AIRFLOW_SECRET_KEY=change_me_secret_key

# ---- Pipeline overrides (optional; defaults live in config/pipeline.yml) ----
# PIPELINE_LAYER_FORMAT=parquet
# PIPELINE_MODEL_SEED=42
